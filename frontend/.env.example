# ===========================================================
# MaxVolt Frontend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to git.
# ===========================================================

# ─── Backend API URL ───────────────────────────────────────
# Variable:         VITE_API_URL
# Purpose:          The URL that the frontend uses to reach the backend API.
# Required:         Yes (defaults to /api via Vite proxy in development)
# Used by:          src/services/client.js
# Example format:   http://localhost:5000/api  (dev, using localhost)
#                   http://192.168.x.x:5000/api (dev, mobile on same LAN)
#                   https://api.yourdomain.com/api (production)
# Security:         Not sensitive — visible in browser bundle
#
# In development the Vite dev server proxies /api to localhost:5000
# automatically, so this default already works. Only change it when:
#   • Testing from a physical mobile device on the same LAN
#     (replace localhost with your machine's LAN IP address)
#   • Deploying to production (use the real backend URL)
VITE_API_URL=http://localhost:5173/api

# ─── Google OAuth Client ID ────────────────────────────────
# Variable:         VITE_GOOGLE_CLIENT_ID
# Purpose:          Enables "Continue with Google" sign-in.
# Required:         No (button is visible; Google sign-in is disabled until set)
# Used by:          src/components/common/GoogleSignInButton.jsx
# Example format:   123456789-abcdefghijklmnop.apps.googleusercontent.com
# Where to obtain:  https://console.cloud.google.com/apis/credentials
#                   Create an OAuth 2.0 Client ID, add Authorized JavaScript
#                   origins: http://localhost:5173 (dev) / your production URL
# Must match:       GOOGLE_CLIENT_ID in backend/.env
# Security:         Not sensitive — this is a public OAuth client ID
VITE_GOOGLE_CLIENT_ID=