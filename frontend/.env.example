# Backend API base URL (no trailing slash). In dev we also proxy /api
# to the backend via Vite, so this default is already correct.
VITE_API_URL=http://10.231.162.56:5173/api

# Google OAuth client ID for "Continue with Google" (must match
# GOOGLE_CLIENT_ID in backend/.env). The button is always visible,
# but sign-in only works once a real client ID is set here AND the
# origin is listed in Google Cloud's "Authorized JavaScript origins".
# Create one at https://console.cloud.google.com/apis/credentials
# with Authorized JavaScript origins = http://localhost:5173
VITE_GOOGLE_CLIENT_ID=