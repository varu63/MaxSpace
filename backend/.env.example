# Server
PORT=5000

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend origin (CORS + dev)
# FRONTEND_URL=http://localhost:5173
# CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://10.231.162.56:5173
CLIENT_URL=http://10.231.162.56:5173

# Data source mode:
#   mock     — in-memory seeded store (default, no database required)
#   postgres — PostgreSQL repository (requires DATABASE_URL)
DATA_SOURCE=mock

# PostgreSQL connection string (only required when DATA_SOURCE=postgres)
DATABASE_URL=postgresql://maxspace_user:maxspace_password@localhost:5432/maxspace_db

# Google OAuth (Google Sign-In)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   - GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID in frontend/.env
#   - Authorized JavaScript origins: http://localhost:5173
# The frontend "Continue with Google" button is always visible; it only completes
# sign-in once a real client ID is set here.
# GOOGLE_CLIENT_SECRET is only needed for server-side code exchanges (not used
# by the current ID-token flow) but is listed for completeness.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL is only needed for the OAuth 2.0 authorization-code
# flow (the current sign-in uses ID-token verification). Example:
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback