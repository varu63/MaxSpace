# Server
PORT=5000

# JWT
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# Frontend origin (CORS + dev)
# FRONTEND_URL=http://localhost:5173
# CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://10.231.162.56:5173
CLIENT_URL=http://10.231.162.56:5173

# Data source mode:
#   mock     — in-memory seeded store (default, no database required)
#   postgres — PostgreSQL repository (requires DATABASE_URL)
DATA_SOURCE=mock

# PostgreSQL connection string (only required when DATA_SOURCE=postgres).
# MaxSpace uses the existing maxvolt_prod production database as its source
# of truth: connect here and run `node backend/scripts/migrate.js` to apply
# the schema-adaptation migrations (000_*) against it.
DATABASE_URL=postgresql://maxspace_user:maxspace_password@localhost:5432/maxvolt_prod

# Schema that holds the legacy production tables (battery_models, cells,
# bms_inventory, pack_testing_reports, pdi_reports, dispatch_records,
# laser_welding_data, battery_cell_mapping). On maxvolt_prod those live in
# `public`, so leave empty. Set to the mirror schema (e.g. maxspace_pro)
# only if pointing at an old mirrored database.
# LEGACY_SCHEMA=

# POST /api/data/reset TRUNCATEs the app tables. Keep this OFF (default) on
# the production database — it must only be enabled for a disposable dev db.
# ALLOW_DB_RESET=false

# Google OAuth (Google Sign-In)
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   - GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID in frontend/.env
#   - Authorized JavaScript origins: http://localhost:5173
# The frontend "Continue with Google" button is always visible; it only completes
# sign-in once a real client ID is set here.
# GOOGLE_CLIENT_SECRET is only needed for server-side code exchanges (not used
# by the current ID-token flow) but is listed for completeness.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL is only needed for the OAuth 2.0 authorization-code
# flow (the current sign-in uses ID-token verification). Example:
# GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback