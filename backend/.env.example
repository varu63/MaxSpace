# ============================================================
# MaxSpace backend configuration
#
# PostgreSQL is the ONLY supported data source. There is no mock or
# in-memory mode: if DATABASE_URL is missing or the database cannot be
# reached, the server fails to start with an actionable error rather
# than silently serving demo data.
#
# Copy to .env and fill in the blanks:  cp .env.example .env
# ============================================================

# --- Server -------------------------------------------------------------
PORT=5000
NODE_ENV=development

# --- Database (required) -----------------------------------------------
# The single source of truth. sql/schema.sql is authoritative and
# re-runnable; apply it with:
#     npm run db:migrate          # apply
#     npm run db:migrate -- --status   # what is applied
#     npm run db:migrate -- --check    # dry run, rolled back
DATABASE_URL=postgresql://maxspace_user:your_password_here@localhost:5432/dev

# The database user needs rights to CREATE DATABASE when running the
# test suite: each test file builds and drops its own throwaway
# database from schema.sql. Tests skip themselves (rather than fail) if
# no database is reachable.
# CREATE DATABASE maxspace_test_% OWNER maxspace_user;

# --- Auth ---------------------------------------------------------------
# Generate a real secret; the server refuses a weak/placeholder one.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- E-mail (Resend) ----------------------------------------------------
# Account verification + password-reset emails are sent through Resend
# (https://resend.com) from the BACKEND only. The API key must never be
# exposed to the frontend: do NOT prefix it with VITE_ and do NOT put it
# in frontend/.env.
#   1. Create an API key:  https://resend.com/api-keys
#   2. Verify your sending domain (DNS records) and use it in
#      RESEND_FROM_EMAIL, e.g. no-reply@your-domain.com
# Without a key the flows still work in development: the link is appended
# to %TEMP%/maxspace-auth-links.log instead of being emailed, and the
# server refuses to send at all when NODE_ENV=production.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MaxSpace
# Public URL of THIS backend — used to build the e-mail verification link
# (it must point at the API, not at the React app).
APP_BASE_URL=http://localhost:5000

# --- CORS / frontend origin --------------------------------------------
# Comma-separate if the frontend runs in more than one place.
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

# --- Optional -----------------------------------------------------------
# Shared secret for IoT/BMS device ingest. Leave EMPTY and only an ADMIN
# JWT may POST telemetry. When set, a gateway may push real readings with
# the X-IoT-Device-Key header.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IOT_DEVICE_KEY=

# Google Sign-In. Create an OAuth 2.0 Client ID at
# https://console.cloud.google.com/apis/credentials
#   - GOOGLE_CLIENT_ID must match VITE_GOOGLE_CLIENT_ID in frontend/.env
#   - Authorized JavaScript origins: http://localhost:5173
#   - GOOGLE_CALLBACK_URL is only needed for the authorization-code flow;
#     the current sign-in verifies an ID token instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=